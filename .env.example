# Copy this file to .env.local and fill in your own values.
# Find them in Supabase → Project Settings → Data API / API Keys.
#
# Only the PUBLISHABLE key goes here. Never put the secret key
# (sb_secret_… / service_role) or the database password in any env file
# the browser can see — Vite ships every VITE_* value to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# "demo" = mock data in the browser, "supabase" = the real database.
VITE_DATA_SOURCE=demo
